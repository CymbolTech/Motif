# Staging on cymbol.ir. On the server: cp .env.staging.example .env, fill every empty
# secret, then run `make production-env-check` before `make up` (or `make up-proxy`).
# Staging runs with production validation so a public host never starts on dev defaults.
# Empty secrets fail closed: the API refuses to start in production with default credentials.
# Generate each secret with: openssl rand -hex 32

MOTIF_RUNTIME_ENV=production

# Public URLs, no trailing slash. They are baked into the console and landing builds,
# so changing them later (for the real domain) needs `make up` to rebuild the images.
MOTIF_CONSOLE_URL=https://motif-console.cymbol.ir
MOTIF_MARKETING_URL=https://motif.cymbol.ir
MOTIF_CORS_ORIGINS=https://motif-console.cymbol.ir,https://motif.cymbol.ir

# Nginx Proxy Manager on the host forwards to 127.0.0.1:4173 / :4174 (leave COMPOSE_FILE unset).
# Nginx Proxy Manager in Docker: uncomment so every make target keeps the shared proxy network.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=proxy
PUBLIC_BIND=127.0.0.1
DASHBOARD_PORT=4173
MARKETING_PORT=4174

POSTGRES_USER=motif
POSTGRES_PASSWORD=
POSTGRES_DB=motif
POSTGRES_PORT=15432
NATS_PORT=14222
NATS_MONITOR_PORT=18222
API_PORT=18080
WORKER_PORT=18081

MOTIF_BOOTSTRAP_API_KEY=
MOTIF_BOOTSTRAP_TENANT=demo-tenant
MOTIF_BOOTSTRAP_ENVIRONMENT=sandbox
MOTIF_ADMIN_API_KEY=
MOTIF_ADMIN_EMAIL=
MOTIF_ADMIN_PASSWORD=
MOTIF_REWARD_PROVIDER_ENCRYPTION_KEY=

# Behind the proxies every request reaches the API from the console container's address,
# so all users and integrations share one rate-limit bucket. Sized for that until the API
# reads the forwarded client address.
MOTIF_RATE_LIMIT_RPS=100
MOTIF_RATE_LIMIT_BURST=200
MOTIF_METRICS_ENABLED=true

MOTIF_REWARD_PROVIDER=mock
MOTIF_REWARD_PROVIDER_URL=
MOTIF_REWARD_PROVIDER_STATUS_URL=
MOTIF_REWARD_PROVIDER_TOKEN=
MOTIF_REWARD_PROVIDER_TIMEOUT_SECONDS=8
