# These values are for local development only. Change them outside a private workstation.
POSTGRES_USER=motif
POSTGRES_PASSWORD=motif_local_only
POSTGRES_DB=motif
DATABASE_URL=postgres://motif:motif_local_only@localhost:15432/motif?sslmode=disable
MOTIF_RUNTIME_ENV=development
NATS_URL=nats://localhost:14222
API_ADDR=127.0.0.1:8080
WORKER_HEALTH_ADDR=127.0.0.1:8081
MOTIF_BOOTSTRAP_API_KEY=dev_only_change_me
MOTIF_BOOTSTRAP_TENANT=demo-tenant
MOTIF_BOOTSTRAP_ENVIRONMENT=sandbox
MOTIF_ADMIN_API_KEY=admin_dev_only_change_me
MOTIF_ADMIN_EMAIL=admin@motif.local
MOTIF_ADMIN_PASSWORD=admin_dev_only_change_me
MOTIF_CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174
MOTIF_RATE_LIMIT_RPS=30
MOTIF_RATE_LIMIT_BURST=60
MOTIF_METRICS_ENABLED=true
MOTIF_REWARD_PROVIDER=mock
MOTIF_REWARD_PROVIDER_URL=
MOTIF_REWARD_PROVIDER_STATUS_URL=
MOTIF_REWARD_PROVIDER_TOKEN=
MOTIF_REWARD_PROVIDER_ENCRYPTION_KEY=
MOTIF_REWARD_PROVIDER_TIMEOUT_SECONDS=8

# Host ports used by the Docker Compose workflow. Change these when another local stack uses them.
POSTGRES_PORT=15432
NATS_PORT=14222
NATS_MONITOR_PORT=18222
API_PORT=18080
WORKER_PORT=18081
MCP_PORT=18082

# Public web services served by Docker Compose. On a VPS, set these to the
# domains configured in Nginx Proxy Manager and use https:// origins.
MOTIF_CONSOLE_URL=http://127.0.0.1:4173
MOTIF_MARKETING_URL=http://127.0.0.1:4174
PUBLIC_BIND=127.0.0.1
DASHBOARD_PORT=4173
MARKETING_PORT=4174
